# Copy to .env.discord-bridge.local (git-ignored) for Supabase secrets set.
# The token, secret and Discord IDs must match the bot environment.
DISCORD_BOT_TOKEN=
DISCORD_BRIDGE_SECRET=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_AUTHOR_ID=
DISCORD_IMPORT_FROM=2026-11-18
# Supabase Auth user UUID, NOT an email address or Discord user ID.
DISCORD_OWNER_USER_ID=
# Keep the existing DISCORD_WEBHOOK_URL and DISCORD_SYNC_FROM secrets.
